        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "purchasePrice", "targetPrice", "status"]
    },
    "clients": {
      "title": "CRM Clients and Wishlists",
      "description": "Client database, wishlist orders, tags and transaction records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name"]
    },
    "goals": {
      "title": "User Profit & Turnover Goals",
      "description": "Monthly targets, turnover goals and milestones",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
