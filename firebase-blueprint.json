{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profiles and store settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "operator", "seller"] },
        "phone": { "type": "string" },
        "storeName": { "type": "string" },
        "storeAddress": { "type": "string" },
        "storeDocument": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "vehicles": {
      "title": "Stock Items (Vehicles, Electronics & Brik)",
      "description": "Inventory items including products, trade-ins, costs, and sales status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "targetPrice": { "type": "number" },
        "status": { "type": "string" },
